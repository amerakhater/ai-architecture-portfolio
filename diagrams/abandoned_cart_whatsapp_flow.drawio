<mxfile host="app.diagrams.net" modified="2026-11-03T13:10:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="abandoned-cart-flow" name="Abandoned Cart WhatsApp Nudge"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Abandoned-Cart WhatsApp Nudge — Use-Case Flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1500" height="45" as="geometry" /></mxCell><mxCell id="subtitle" value="Trigger after 30 minutes of cart inactivity • Personalize with batch-precomputed Top-K products • Operational DB is not queried by the send path" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1500" height="35" as="geometry" /></mxCell><mxCell id="headc1" value="Channels and API Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="115" width="245" height="55" as="geometry" /></mxCell><mxCell id="headc2" value="E-commerce service and operational DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="285" y="115" width="245" height="55" as="geometry" /></mxCell><mxCell id="sep1" value="" style="shape=line;strokeColor=#dddddd;" vertex="1" parent="1"><mxGeometry x="279" y="180" width="1" height="700" as="geometry" /></mxCell><mxCell id="headc3" value="CDC → Kafka → Flink" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="115" width="245" height="55" as="geometry" /></mxCell><mxCell id="sep2" value="" style="shape=line;strokeColor=#dddddd;" vertex="1" parent="1"><mxGeometry x="534" y="180" width="1" height="700" as="geometry" /></mxCell><mxCell id="headc4" value="Airflow and CDP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="795" y="115" width="245" height="55" as="geometry" /></mxCell><mxCell id="sep3" value="" style="shape=line;strokeColor=#dddddd;" vertex="1" parent="1"><mxGeometry x="789" y="180" width="1" height="700" as="geometry" /></mxCell><mxCell id="headc5" value="Feature store and vector DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1050" y="115" width="245" height="55" as="geometry" /></mxCell><mxCell id="sep4" value="" style="shape=line;strokeColor=#dddddd;" vertex="1" parent="1"><mxGeometry x="1044" y="180" width="1" height="700" as="geometry" /></mxCell><mxCell id="headc6" value="Recommendation engine and WhatsApp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1305" y="115" width="245" height="55" as="geometry" /></mxCell><mxCell id="sep5" value="" style="shape=line;strokeColor=#dddddd;" vertex="1" parent="1"><mxGeometry x="1299" y="180" width="1" height="700" as="geometry" /></mxCell><mxCell id="bglabel" value="BACKGROUND INGESTION + BATCH PATH" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1a6e42;" vertex="1" parent="1"><mxGeometry x="30" y="185" width="1500" height="30" as="geometry" /></mxCell><mxCell id="b1" value="Customer views / adds / removes items; checkout events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="235" width="205" height="85" as="geometry" /></mxCell><mxCell id="b2" value="Persist cart, customer, product and consent state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="235" width="205" height="85" as="geometry" /></mxCell><mxCell id="b3" value="CDC publishes changes → Kafka topics; Flink cleans, joins and maintains customer/cart event state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="555" y="220" width="205" height="115" as="geometry" /></mxCell><mxCell id="b4" value="Airflow schedules daily/hourly jobs; CDP builds customer segments and eligible audiences" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="810" y="220" width="205" height="115" as="geometry" /></mxCell><mxCell id="b5" value="Update customer/product features; build item embeddings and similarity index in Vector DB; write Top-K per customer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1065" y="210" width="205" height="135" as="geometry" /></mxCell><mxCell id="b6" value="Batch recommendation job scores candidates and stores ranked Top-K list in Feature Store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1320" y="220" width="205" height="115" as="geometry" /></mxCell><mxCell id="be1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="be2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="be3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="be4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="be5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rtlabel" value="REAL-TIME REQUEST / TRIGGER PATH" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1500" height="30" as="geometry" /></mxCell><mxCell id="r1" value="Customer adds item to cart; channel sends request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="465" width="205" height="80" as="geometry" /></mxCell><mxCell id="r2" value="API validates request; e-commerce service writes cart to operational DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="465" width="205" height="80" as="geometry" /></mxCell><mxCell id="r3" value="CDC → Kafka → Flink tracks cart events; keyed state starts/resets 30-min inactivity timer; emits AbandonedCart event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="555" y="450" width="205" height="110" as="geometry" /></mxCell><mxCell id="r4" value="CDP-derived consent / eligibility audience is available from the replicated profile data (no live DB lookup)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="810" y="455" width="205" height="100" as="geometry" /></mxCell><mxCell id="r5" value="Read precomputed customer Top-K from Feature Store; optionally filter against current cart items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1065" y="455" width="205" height="100" as="geometry" /></mxCell><mxCell id="r6" value="Recommendation engine selects message/products; WhatsApp sends template nudge; delivery/status events return to Kafka" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1320" y="445" width="205" height="120" as="geometry" /></mxCell><mxCell id="re1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="re2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="re3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="re4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="r4" target="r5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="re5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="r5" target="r6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cross1" value="Top-K lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#6c8ebf;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="b6" target="r5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cross2" value="Consent / segment snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#82b366;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="b4" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="latency" value="Illustrative P95 send-path budget after 30-min inactivity threshold: Flink detect/emit 150 ms • eligibility + feature lookup 200 ms • rank/select + message assembly 250 ms • WhatsApp API handoff 1,000 ms • total ≈ 1.6 s (excluding provider delivery time)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="1500" height="60" as="geometry" /></mxCell><mxCell id="notes" value="Design notes: Flink keyed state handles the inactivity timer; this avoids adding a separate scheduler. The Vector DB is used in the batch candidate-generation path, not on each nudge. Use idempotency keys / deduplication for repeated events and suppress sends after a purchase, cart clear, opt-out, or recent nudge." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="1500" height="70" as="geometry" /></mxCell><mxCell id="legend" value="Solid arrows = event/request flow     Dashed arrows = background data dependency" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="785" width="1000" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>